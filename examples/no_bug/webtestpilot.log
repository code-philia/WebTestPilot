                    def postcondition(session: Session):                                                                                             
                        from typing import List, Optional                                                                                            
                        from pydantic import BaseModel, Field                                                                                        
                                                                                                                                                     
                        # Define schema for a comment node (supports nested replies)                                                                 
                        class Comment(BaseModel):                                                                                                    
                            id: int = Field(..., description="Unique identifier for the comment")                                                    
                            author: str = Field(..., description="Author of the comment")                                                            
                            content: str = Field(..., description="Text content of the comment")                                                     
                            replies: Optional[List["Comment"]] = Field(default_factory=list, description="List of reply                              
                    comments")                                                                                                                       
                                                                                                                                                     
                        Comment.update_forward_refs()                                                                                                
                                                                                                                                                     
                        class CommentsTree(BaseModel):                                                                                               
                            comments: List[Comment] = Field(default_factory=list, description="Top-level comments (with nested                       
                    replies)")                                                                                                                       
                                                                                                                                                     
                        # Extract initial and current comments tree                                                                                  
                        initial_comments = session.history[1].extract("extract all comments as tree",                                                
                    schema=CommentsTree).comments                                                                                                    
                        current_comments = session.history[-1].extract("extract all comments as tree",                                               
                    schema=CommentsTree).comments                                                                                                    
                                                                                                                                                     
                        def flatten_comments(comments: List[Comment]) -> List[Comment]:                                                              
                            """Flatten the comment tree into a list (preorder traversal)."""                                                         
                            result = []                                                                                                              
                            for c in comments:                                                                                                       
                                result.append(c)                                                                                                     
                                if c.replies:                                                                                                        
                                    result.extend(flatten_comments(c.replies))                                                                       
                            return result                                                                                                            
                                                                                                                                                     
                        initial_flat = flatten_comments(initial_comments)                                                                            
                        current_flat = flatten_comments(current_comments)                                                                            
                                                                                                                                                     
                        # There should be exactly one new comment                                                                                    
                        assert len(current_flat) == len(initial_flat) + 1, (                                                                         
                            f"Expected exactly one new comment, but found {len(current_flat) - len(initial_flat)} new                                
                    comments."                                                                                                                       
                        )                                                                                                                            
                                                                                                                                                     
                        # Find the new comment by id (assuming ids are unique and new one is not in initial)                                         
                        initial_ids = {c.id for c in initial_flat}                                                                                   
                        new_comments = [c for c in current_flat if c.id not in initial_ids]                                                          
                        assert len(new_comments) == 1, "There should be exactly one new comment node."                                               
                                                                                                                                                     
                        new_comment = new_comments[0]                                                                                                
                        # Check that the new comment content matches what was entered                                                                
                        assert new_comment.content == "I like this template", (                                                                      
                            f"New comment content mismatch: expected 'I like this template', got '{new_comment.content}'"                            
                        )                                                                                                                            
                                                                                                                                                     
                        # Check that all other comments (by id) are unchanged in content and structure                                               
                        initial_by_id = {c.id: c for c in initial_flat}                                                                              
                        for c in current_flat:                                                                                                       
                            if c.id in initial_by_id:                                                                                                
                                orig = initial_by_id[c.id]                                                                                           
                                assert c.content == orig.content, f"Comment content changed for id {c.id}."                                          
                                assert c.author == orig.author, f"Comment author changed for id {c.id}."                                             
                                assert len(c.replies) == len(orig.replies), f"Replies count changed for comment id {c.id}."                          
                                                                                                                                                     
                        # Optionally, check that the new comment is appended at the end (as per UI)                                                  
                        assert current_flat[-1].id == new_comment.id, "New comment is not the last in the comments list as                           
