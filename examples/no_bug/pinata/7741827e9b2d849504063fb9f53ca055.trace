":{"s":"<span role=\"presentation\" class=\"icon text-bookshelf\" ></span>"}}],"id":15},{"o":[{"k":"mark","v":{"s":"14"}},{"k":"element","v":{"s":"<h4 class=\"entity-list-item-name break-text\" >Shelf</h4>"}}],"id":16},{"o":[{"k":"mark","v":{"s":"15"}},{"k":"element","v":{"s":"<span role=\"presentation\" class=\"icon text-page\" ></span>"}}],"id":17},{"o":[{"k":"mark","v":{"s":"16"}},{"k":"element","v":{"s":"<h4 class=\"entity-list-item-name break-text\" >Page 1</h4>"}}],"id":18},{"o":[{"k":"mark","v":{"s":"17"}},{"k":"element","v":{"s":"<span role=\"presentation\" class=\"icon text-book\" ></span>"}}],"id":19},{"o":[{"k":"mark","v":{"s":"18"}},{"k":"element","v":{"s":"<h4 class=\"entity-list-item-name break-text\" >Book1</h4>"}}],"id":20},{"o":[{"k":"mark","v":{"s":"19"}},{"k":"element","v":{"s":"<span role=\"presentation\" class=\"icon text-chapter\" ></span>"}}],"id":21},{"o":[{"k":"mark","v":{"s":"20"}},{"k":"element","v":{"s":"<h4 class=\"entity-list-item-name break-text\" >Chapter 2</h4>"}}],"id":22},{"o":[{"k":"mark","v":{"s":"21"}},{"k":"element","v":{"s":"<span role=\"presentation\" class=\"icon text-page\" ></span>"}}],"id":23},{"o":[{"k":"mark","v":{"s":"22"}},{"k":"element","v":{"s":"<h4 class=\"entity-list-item-name break-text\" >Page</h4>"}}],"id":24},{"o":[{"k":"mark","v":{"s":"23"}},{"k":"element","v":{"s":"<span role=\"presentation\" class=\"icon text-book\" ></span>"}}],"id":25},{"o":[{"k":"mark","v":{"s":"24"}},{"k":"element","v":{"s":"<h4 class=\"entity-list-item-name break-text\" >Book</h4>"}}],"id":26},{"o":[{"k":"mark","v":{"s":"25"}},{"k":"element","v":{"s":"<span role=\"presentation\" class=\"icon text-page\" ></span>"}}],"id":27},{"o":[{"k":"mark","v":{"s":"26"}},{"k":"element","v":{"s":"<h4 class=\"entity-list-item-name break-text\" >Page Template</h4>"}}],"id":28},{"o":[{"k":"mark","v":{"s":"27"}},{"k":"element","v":{"s":"<span role=\"presentation\" class=\"icon text-page\" ></span>"}}],"id":29},{"o":[{"k":"mark","v":{"s":"28"}},{"k":"ele