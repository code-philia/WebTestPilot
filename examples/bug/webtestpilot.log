                            return {                                                                                 
                                "id": c.id,                                                                          
                                "author": c.author,                                                                  
                                "content": c.content,                                                                
                                "replies": [comment_dict(r) for r in c.replies] if c.replies                         
                    else [],                                                                                         
                            }                                                                                        
                                                                                                                     
                        # Remove the new comment from the current tree for comparison                                
                        def remove_new_comment(comments: List[Comment], new_id: int) ->                              
                    List[Comment]:                                                                                   
                            result = []                                                                              
                            for c in comments:                                                                       
                                if c.id == new_id:                                                                   
                                    continue                                                                         
                                c_copy = Comment(**c.dict())                                                         
                                if c_copy.replies:                                                                   
                                    c_copy.replies = remove_new_comment(c_copy.replies,                              
                    new_id)                                                                                          
                                result.append(c_copy)                                                                
                            return result                                                                            
                                                                                                                     
                        current_without_new = remove_new_comment(current_comments,                                   
