                        class Comment(BaseModel):                                                                    
                            id: int = Field(..., description="Unique identifier for the                              
                    comment")                                                                                        
                            author: str = Field(..., description="Author of the comment")                            
                            content: str = Field(..., description="Text content of the                               
                    comment")                                                                                        
                            replies: Optional[List["Comment"]] = Field(default_factory=list,                         
                    description="List of replies to this comment")                                                   
                                                                                                                     
                        Comment.update_forward_refs()                                                                
                                                                                                                     
                        class CommentsTree(BaseModel):                                                               
                            comments: List[Comment] = Field(default_factory=list,                                    
                    description="Top-level comments with nested replies")                                            
                                                                                                                     
                        # Extract initial and current comments tree                                                  
