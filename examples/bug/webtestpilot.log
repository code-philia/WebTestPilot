                    tree", schema=CommentsTree).comments                                                             
                        current_comments = session.history[-1].extract("extract all comments                         
                    as tree", schema=CommentsTree).comments                                                          
                                                                                                                     
                        def flatten_comments(comments: List[Comment]) -> List[Comment]:                              
                            """Flatten the comment tree into a list of all comments (including                       
                    replies)."""                                                                                     
                            flat = []                                                                                
                            for c in comments:                                                                       
                                flat.append(c)                                                                       
                                if c.replies:                                                                        
                                    flat.extend(flatten_comments(c.replies))                                         
                            return flat                                                                              
                                                                                                                     
                        initial_flat = flatten_comments(initial_comments)                                            
                        current_flat = flatten_comments(current_comments)                                            
                                                                                                                     
                        # There should be exactly one new comment                                                    
                        assert len(current_flat) == len(initial_flat) + 1, (                                         
                            f"Expected exactly one new comment, but found {len(current_flat) -                       
                    len(initial_flat)} new comments."                                                                
                        )                                                                                            
                                                                                                                     
                        # Find the new comment(s)                                                                    
                        initial_ids = {c.id for c in initial_flat}                                                   
                        new_comments = [c for c in current_flat if c.id not in initial_ids]                          
                                                                                                                     
                        assert len(new_comments) == 1, "There should be exactly one new                              
                    comment added."                                                                                  
                                                                                                                     
                        # The new comment should have the expected content                                           
                        new_comment = new_comments[0]                                                                
