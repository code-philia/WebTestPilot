# =========================================================
# Requirements
# =========================================================
# 1. If you run any experiments or baselines:
#    - OPENAI_* must be set
#
# 2. If you run WebTestPilot:
#    - At least ONE of the following must be set:
#      OPENAI_* | GOOGLEAI_* | ANTHROPIC_* | OPENROUTER_*
#
# 3. If you run WebTestPilot with SoM mode:
#    - GUI_GROUNDING_MODEL_* must be set
# =========================================================

# OpenAI — official API or OpenAI-compatible proxy (set OPENAI_BASE_URL for proxy/self-hosted)
OPENAI_BASE_URL=""
OPENAI_API_KEY=""
OPENAI_MODEL_NAME=""

# Google AI — official API only (https://ai.google.dev)
GOOGLEAI_API_KEY=""
GOOGLEAI_MODEL_NAME=""

# Anthropic — official API only (https://api.anthropic.com)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL_NAME=""

# OpenRouter (access 300+ models; supports tool calling for Claude, GPT, etc.)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL_NAME=""

# GUI grounding model
GUI_GROUNDING_MODEL_BASE_URL=""
GUI_GROUNDING_MODEL_NAME=""